# Copie para .env e preencha. Nunca versione o .env.

# Token do bot (Discord Developer Portal > Bot). Ative "Message Content Intent".
DISCORD_BOT_TOKEN=

# ID de usuário do Discord do dono do bot (Modo Desenvolvedor > Copiar ID do usuário).
MEMI_OWNER_ID=
# Admins extras do bot, IDs separados por vírgula. Ex.: 000000000000000000,000000000000000000
MEMI_ADMIN_IDS=

# Opcionais: fontes de dados e imagens
API_FOOTBALL_KEY=
# Sem chave própria, usa-se a chave pública de teste do TheSportsDB ("123").
THESPORTSDB_API_KEY=

# Jogos do campeonato às 19h: ligado por padrão (cada servidor ativa com
# ..campeonato ativar). Use 0 para desligar.
MEMI_CHAMPIONSHIP_SCHEDULER=1
# Pausa (em segundos) entre os lances da narração das partidas.
MEMI_NARRATION_DELAY=1.6
